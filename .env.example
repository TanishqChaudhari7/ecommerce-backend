# Environment: development | test | production
NODE_ENV=development

# Port the Express server listens on
PORT=3000

# PostgreSQL connection string used by the app and migration/seed scripts
DATABASE_URL=postgresql://ecommerce:ecommerce@localhost:5432/ecommerce

# Redis connection string used for caching and sessions
REDIS_URL=redis://localhost:6379

# Comma-separated list of Kafka broker addresses
KAFKA_BROKERS=localhost:9092

# Client id Kafka producers/consumers identify themselves with
KAFKA_CLIENT_ID=ecommerce-backend

# Secret used to sign and verify JWT access tokens
JWT_SECRET=change-me

# Access token expiry (e.g. 15m, 1h, 7d)
JWT_EXPIRES_IN=15m

# Refresh token expiry (e.g. 7d, 30d)
JWT_REFRESH_EXPIRES_IN=7d

# Minimum level logged by Winston (error | warn | info | http | debug) - use "http" to see per-request logs
LOG_LEVEL=http

# Postgres credentials consumed by docker-compose (must match DATABASE_URL)
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce
POSTGRES_DB=ecommerce
